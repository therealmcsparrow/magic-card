# Dependencies
node_modules/

# Build output
# (the release commit tracks all of dist/: the card, its hashed chunks, their .br and .gz copies and the manifest;
# the directory is un-ignored in case a global `dist/` rule would hide it)
!dist/

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key
credentials/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS artifacts
.DS_Store
Thumbs.db
Thumbs.db:encryptable

# Editor directories
.idea/
.vscode/
*.swp
*.swo
*~

# OS specific
nul
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/
*.bak

# Assets: only the finished art originals in assets/brand are tracked
assets/*
!assets/brand/
assets/brand/icon-audit/

# TypeScript
*.tsbuildinfo

# Test coverage
coverage/
# Studio harness
.harness-build/
.harness-shots/

# Internal IDE files
codeeditor.md
DESIGN.md
PRODUCT.md
SYNC_SYSTEM.md

# generated by npm run sbom (release asset)
sbom.cdx.json

# generated by npm run i18n (tools/i18n-build.mjs)
messages.gen.ts
keys.gen.ts
