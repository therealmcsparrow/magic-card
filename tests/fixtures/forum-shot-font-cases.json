    { "id": "unnamed-host", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(https://cdn.example.net/lora.woff2);}", "why": "The host passes the address rule but the panel did not name it, so the list would not be the truth.", "expect": { "result": "failed_fetch", "fetches": [] } },
