{
  "about": "Settled verdicts for hostile font addresses and font responses in the forum shot. Rules: docs/adr/0086-forum-shot-fetches-fonts-from-any-https-host.md. Each case in addressCases is one card config: `css` is shorthand for { type: 'custom:magic-card', css }, `config` is the whole card, and `generate` builds the css as prefix + repeat x count + suffix and must finish within generatedMaxMs. expect.lock is the ForumShotLockReason or null; expect.fontHosts is compared as a set. A locked card has no font hosts. stylesheetCases, fontCases and runCases are responses to a Download: failed_fetch means the run stops with font_unavailable and saves nothing, and fetches lists every font request the stylesheet may cause, compared as a set. expect.faces is compared by the fields it lists. stylesheetDefaults fills what a stylesheet case leaves out; a font case has status 200, responseType cors and a face that loads unless it says otherwise.",
  "origin": "https://ha.example.com",
  "generatedMaxMs": 1000,
  "requestOptions": {
    "credentials": "omit",
    "referrerPolicy": "no-referrer",
    "mode": "cors",
    "redirect": "error",
    "cache": "no-store"
  },
  "limits": {
    "stylesheetBytes": 1000000,
    "fontFileBytes": 5242880,
    "runBytes": 25165824,
    "fetchMs": 8000,
    "requests": 128,
    "parallel": 6,
    "fontHostsPerCard": 8,
    "addressLength": 2048,
    "familyLength": 64,
    "unicodeRangeLength": 4096
  },
  "hostPairs": {
    "fonts.googleapis.com": ["fonts.gstatic.com"]
  },
  "stylesheetDefaults": {
    "stylesheetUrl": "https://fonts.example.com/a.css",
    "fontHosts": ["fonts.example.com"]
  },
  "addressCases": [
    { "id": "import-url", "css": "@import url(https://fonts.example.com/a.css);", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "import-url-quoted", "css": "@import url(\"https://fonts.example.com/a.css\");", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "import-string", "css": "@import \"https://fonts.example.com/a.css\";", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "import-media-words", "css": "@import url(https://fonts.example.com/a.css) screen, print;", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "import-upper-case", "css": "@IMPORT URL(HTTPS://Fonts.Example.COM/a.css);", "why": "CSS keywords, the scheme and the host are case-insensitive; the host is named in lower case.", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "default-port-written", "css": "@import url(https://fonts.example.com:443/a.css);", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "font-face-src", "css": "@font-face{font-family:Foo;src:url(https://cdn.example.net/foo.woff2) format(\"woff2\");}", "expect": { "lock": null, "fontHosts": ["cdn.example.net"] } },
    { "id": "font-face-src-list", "css": "@font-face{font-family:Foo;src:url(https://cdn.example.net/a.woff2) format(\"woff2\"),url(https://fonts.example.com/a.woff) format(\"woff\");}", "why": "Every url() of a src is judged and named, although only one is fetched.", "expect": { "lock": null, "fontHosts": ["cdn.example.net", "fonts.example.com"] } },
    { "id": "font-face-local-first", "css": "@font-face{font-family:Foo;src:local(\"Foo\"),url(https://cdn.example.net/foo.woff2);}", "expect": { "lock": null, "fontHosts": ["cdn.example.net"] } },
    { "id": "google-import", "css": "@import url(https://fonts.googleapis.com/css2?family=Lora:wght@400;700&display=swap);", "why": "A bare `&` that starts no character reference is plain; the Google stylesheet host brings its font host.", "expect": { "lock": null, "fontHosts": ["fonts.googleapis.com", "fonts.gstatic.com"] } },
    { "id": "percent-in-path", "css": "@import url(https://fonts.example.com/a%20b.css);", "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "punycode-host", "css": "@import url(https://xn--mnchen-3ya.example.com/a.css);", "why": "The panel names the ASCII form, so a look-alike host cannot pass for another.", "expect": { "lock": null, "fontHosts": ["xn--mnchen-3ya.example.com"] } },
    { "id": "subdomain-of-ha-host", "css": "@import url(https://fonts.ha.example.com/a.css);", "expect": { "lock": null, "fontHosts": ["fonts.ha.example.com"] } },
    { "id": "public-name-for-loopback", "css": "@import url(https://127.0.0.1.nip.io/a.css);", "why": "A name that resolves to a private address cannot be seen from a browser. It stays a font address; the no-credentials fetch and the content check are the answer.", "expect": { "lock": null, "fontHosts": ["127.0.0.1.nip.io"] } },
    { "id": "css-in-nested-design", "config": { "type": "custom:magic-card", "rows": [{ "type": "text", "design": { "css": "@import url(https://fonts.example.com/a.css);" } }] }, "expect": { "lock": null, "fontHosts": ["fonts.example.com"] } },
    { "id": "eight-hosts", "css": "@import url(https://a.example.com/a.css);@import url(https://b.example.com/a.css);@import url(https://c.example.com/a.css);@import url(https://d.example.com/a.css);@import url(https://e.example.com/a.css);@import url(https://f.example.com/a.css);@import url(https://g.example.com/a.css);@import url(https://h.example.com/a.css);", "expect": { "lock": null, "fontHosts": ["a.example.com", "b.example.com", "c.example.com", "d.example.com", "e.example.com", "f.example.com", "g.example.com", "h.example.com"] } },

    { "id": "google-family-font-family", "config": { "type": "custom:magic-card", "font_family": "\"Open Sans\", sans-serif" }, "expect": { "lock": null, "fontHosts": ["fonts.googleapis.com", "fonts.gstatic.com"] } },
    { "id": "google-family-in-css", "css": ".card { font-family: Lora, serif; }", "expect": { "lock": null, "fontHosts": ["fonts.googleapis.com", "fonts.gstatic.com"] } },
    { "id": "roboto-fetches-nothing", "config": { "type": "custom:magic-card", "font_family": "Roboto" }, "expect": { "lock": null, "fontHosts": [] } },
    { "id": "plain-declarations", "css": "letter-spacing: 0.5px; backdrop-filter: blur(6px)", "expect": { "lock": null, "fontHosts": [] } },

