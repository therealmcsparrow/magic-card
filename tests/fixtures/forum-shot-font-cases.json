    { "id": "nested-import-url", "type": "text/css", "css": "@import url(b.css);@font-face{font-family:Lora;src:url(lora.woff2);}", "expect": { "result": "failed_fetch", "fetches": [] } },
    { "id": "nested-import-string", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.woff2);}@IMPORT \"b.css\";", "expect": { "result": "failed_fetch", "fetches": [] } },
    { "id": "backslash-in-face", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lo\\72 a.woff2);}", "expect": { "result": "failed_fetch", "fetches": [] } },
    { "id": "unterminated-comment", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.woff2);}/* x", "expect": { "result": "failed_fetch", "fetches": [] } },
    { "id": "unterminated-block", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.woff2);", "expect": { "result": "failed_fetch", "fetches": [] } },
    { "id": "no-usable-source", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.svg) format(\"svg\");}", "why": "No face comes out of it, and a font with no face stops the run.", "expect": { "result": "failed_fetch", "fetches": [] } },
