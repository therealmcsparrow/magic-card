  "stylesheetCases": [
    { "id": "one-face", "type": "text/css", "css": "@font-face{font-family:\"Lora\";font-weight:400;font-style:normal;src:url(https://fonts.example.com/lora.woff2) format(\"woff2\");}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora", "weight": "400", "style": "normal" }] } },
    { "id": "type-with-charset", "type": "text/css; charset=utf-8", "css": "@font-face{font-family:Lora;src:url(lora.woff2);}", "why": "A relative source is read against the stylesheet's own address.", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "parent-relative-source", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(../f/lora.woff2);}", "stylesheetUrl": "https://fonts.example.com/css/a.css", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/f/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "variable-weight-and-range", "type": "text/css", "css": "@font-face{font-family:Lora;font-weight:400 700;font-stretch:75% 125%;unicode-range:U+0000-00FF,U+4??;src:url(lora.woff2) format(\"woff2\");}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora", "weight": "400 700", "stretch": "75% 125%", "unicodeRange": "U+0000-00FF,U+4??" }] } },
    { "id": "named-font-host", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(https://cdn.example.net/lora.woff2);}", "fontHosts": ["fonts.example.com", "cdn.example.net"], "expect": { "result": "ok", "fetches": ["https://cdn.example.net/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "google-pair", "type": "text/css", "stylesheetUrl": "https://fonts.googleapis.com/css2?family=Lora", "fontHosts": ["fonts.googleapis.com", "fonts.gstatic.com"], "css": "@font-face{font-family:'Lora';font-style:normal;font-weight:400;font-display:swap;src:url(https://fonts.gstatic.com/s/lora/v1/a.woff2) format('woff2');unicode-range:U+0000-00FF;}", "expect": { "result": "ok", "fetches": ["https://fonts.gstatic.com/s/lora/v1/a.woff2"], "faces": [{ "family": "Lora", "weight": "400", "style": "normal" }] } },
    { "id": "first-usable-source-only", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.woff2) format(\"woff2\"),url(https://evil.example.net/b.ttf) format(\"truetype\");}", "why": "A source after the first usable one is dropped unread.", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "local-then-url", "type": "text/css", "css": "@font-face{font-family:Lora;src:local(\"Lora\"),url(lora.woff);}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff"], "faces": [{ "family": "Lora" }] } },
    { "id": "unusable-hint-skipped", "type": "text/css", "css": "@font-face{font-family:Lora;src:url(lora.eot) format(\"embedded-opentype\"),url(lora.woff2) format(\"woff2\");}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "other-rules-dropped-unread", "type": "text/css", "css": ".x{background:url(https://evil.example.net/p.png)}@media print{@import url(https://evil.example.net/b.css);}@font-face{font-family:Lora;src:url(lora.woff2);}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "face-in-media-dropped", "type": "text/css", "css": "@media screen{@font-face{font-family:Bad;src:url(https://evil.example.net/b.woff2);}}@font-face{font-family:Lora;src:url(lora.woff2);}", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
    { "id": "breakout-family-dropped", "type": "text/css", "css": "@font-face{font-family:\"x;}body{background:url(https://evil.example.net/p.png)}\";src:url(x.woff2);}@font-face{font-family:Lora;src:url(lora.woff2);}", "why": "A value outside its grammar drops its rule; the rule's source is never fetched.", "expect": { "result": "ok", "fetches": ["https://fonts.example.com/lora.woff2"], "faces": [{ "family": "Lora" }] } },
