{
  "name": "magic-card",
  "version": "2026.10.11-beta.4",
  "description": "A fully open-source Home Assistant Lovelace custom card with multi-mode configuration editor",
  "main": "dist/magic-card.js",
  "scripts": {
    "prebuild": "node -p \"'export const VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts && npm run i18n",
    "i18n": "node tools/i18n-build.mjs",
    "build": "webpack --mode production",
    "predev": "npm run i18n",
    "prewatch": "npm run i18n",
    "prelint": "npm run i18n",
    "prebuild:harness": "npm run i18n",
    "size": "node tools/check-dist-size.mjs",
    "notices": "node tools/third-party-notices.mjs",
    "sbom": "cyclonedx-npm --omit dev --output-format JSON --output-file sbom.cdx.json",
    "dev": "webpack serve --mode development",
    "watch": "webpack --mode development --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:harness": "webpack --mode development --output-path .harness-build",
    "shoot": "node scripts/shoot.mjs"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs"
  ],
  "author": "therealmcsparrow",
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^5.5.0",
    "lit": "^3.3.3",
    "marked": "^18.1.1",
    "swiper": "^14.3.0"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "^10.0.1",
    "@mdi/js": "^7.4.47",
    "css-loader": "^7.1.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.13.0",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "webpack": "^5.112.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
