      "animation_color": { "chunk": "anim", "reserve": "overlay" },
      "ring": { "chunk": "decor", "reserve": "overlay" },
      "shape": { "chunk": "decor", "reserve": "configured" },
      "shape_options": { "chunk": "decor", "reserve": "configured" },
