{
  "description": "Allowlist of config keys that load no chunk (plain keys), with the feature and host keys",
  "rule": "A config is plain when every key the walker meets is in this file as plain. A key found in `features` is a feature (its chunk and reserve kind come from here). Any other key is unknown and counts as a feature (a missed key costs a fetch, never a blank card).",
  "provenance": {
    "design_css": "key names of src/utils/css-properties.ts (prop() entries, plus the per-side longhands of BOX_LONGHANDS and border_length*), copied 2026-10-20 at base 0ce341e",
    "module_keys": "interfaces in src/types.ts (TextModuleConfig ... ClockModuleConfig), copied 2026-10-20",
    "seasonal_presets": "SEASONAL_PRESETS in src/utils/animation-presets.ts; the ids are listed in SEASONAL_PRESET_IDS in src/utils/seasonal.needs.ts"
  },
  "host_keys_ignored": {
    "note": "Keys Home Assistant itself reads on every card. They are not Magic Card config and load no chunk.",
    "keys": ["grid_options", "view_layout", "layout_options", "visibility"]
  },
  "noop_keys": {
    "note": "Known keys the renderer ignores, listed as plain so needs() (false) and this file agree. Only named keys qualify; an unlisted key stays unknown = feature.",
    "keys": { "vertical": ["justify"] }
  },
  "card": ["type", "name", "entity", "not_synced", "rows", "use_page_theme", "theme", "background", "background_image", "border_radius", "padding", "border_width", "border_style", "border_color", "opacity", "backdrop_filter", "margin", "box_shadow", "card_height", "overflow", "css", "hover", "display", "conditional_appearance", "background_layers"],
  "appearance_override": ["background", "background_image", "border_radius", "padding", "border_width", "border_style", "border_color", "opacity", "backdrop_filter", "margin", "box_shadow", "card_height", "use_page_theme", "theme", "background_layers"],
  "appearance_rule": ["id", "name", "conditions", "mode", "overrides"],
  "layout_node": ["id", "entity", "share_entity", "not_synced", "layout", "column_widths", "gap", "padding", "vertical_align", "display", "design", "actions", "hidden", "editor_name", "columns", "modules"],
  "module_common": ["id", "type", "entity", "attribute", "display", "design", "actions", "hidden", "editor_name", "not_synced", "placement", "layer"],
  "module_types": {
    "horizontal": ["modules", "gap", "align", "justify", "share_entity"],
    "vertical": ["modules", "gap", "align", "justify", "share_entity"],
    "row": ["columns", "layout", "column_widths", "gap", "padding", "share_entity"],
    "text": ["text", "use_template", "use_entity", "entity_display"],
    "icon": ["icon", "size", "icon_color", "use_entity_icon", "use_entity_color", "icon_on", "icon_off"],
    "info": ["prefix", "suffix", "show_name", "show_state", "show_unit", "secondary_info", "show_icon", "icon", "icon_on", "icon_off"],
    "button": ["label", "icon", "show_state", "use_entity_icon", "use_entity_color", "button_style", "icon_on", "icon_off"],
    "bar": ["min", "max", "severity", "decimals", "bar_height", "bar_color", "bar_background", "show_value", "direction"],
    "separator": ["separator_style", "separator_color", "separator_width", "direction"]
  },
  "tab_keys_walked": ["label", "icon", "modules", "hidden"],
  "icon_keys": {
    "note": "Plain only through ha-icon: a Material Design Icon id. Any other value (mcu:, svg, another set) is the svg-icon feature.",
    "keys": ["icon", "icon_on", "icon_off"],
    "plain_pattern": "^mdi:[a-z0-9][a-z0-9-]*$"
  },
  "design": {
    "css": ["margin", "padding", "width", "height", "min_width", "min_height", "max_width", "max_height", "box_sizing", "border", "border_top", "border_right", "border_bottom", "border_left", "border_width", "border_style", "border_color", "border_radius", "outline", "outline_width", "outline_style", "outline_color", "outline_offset", "box_shadow", "position", "top", "right", "bottom", "left", "inset", "display", "visibility", "opacity", "z_index", "overflow", "overflow_x", "overflow_y", "float", "clear", "cursor", "pointer_events", "font_family", "font_size", "font_weight", "font_style", "font_variant", "color", "text_align", "text_decoration", "text_transform", "text_indent", "text_overflow", "text_shadow", "line_height", "letter_spacing", "word_spacing", "white_space", "word_break", "overflow_wrap", "background", "background_color", "background_image", "background_position", "background_size", "background_repeat", "background_attachment", "background_clip", "background_origin", "backdrop_filter", "flex_direction", "flex_wrap", "justify_content", "align_items", "align_content", "gap", "row_gap", "column_gap", "flex", "flex_grow", "flex_shrink", "flex_basis", "align_self", "order", "grid_template_columns", "grid_template_rows", "grid_template_areas", "grid_auto_columns", "grid_auto_rows", "grid_auto_flow", "grid_column", "grid_row", "grid_area", "transition", "transition_property", "transition_duration", "transition_timing_function", "transition_delay", "transform", "transform_origin", "animation_name", "animation_duration", "animation_timing_function", "animation_delay", "animation_iteration_count", "animation_direction", "animation_fill_mode", "animation_play_state", "filter", "list_style", "list_style_type", "list_style_position", "list_style_image", "border_collapse", "border_spacing", "table_layout", "caption_side", "margin_top", "margin_right", "margin_bottom", "margin_left", "padding_top", "padding_right", "padding_bottom", "padding_left", "border_top_left_radius", "border_top_right_radius", "border_bottom_right_radius", "border_bottom_left_radius", "border_length", "border_length_align", "border_length_sides", "icon_position", "content_align", "content_vertical_align", "icon_size", "icon_gap", "label_overflow", "state_position", "icon_color", "label_color", "state_color", "icon_background", "icon_background_shape", "label_font_family", "label_font_size", "label_font_weight", "label_text_transform", "state_font_size", "tab_bar_position", "tab_align", "tab_bar_background", "tab_bar_border_color", "tab_bar_border_width", "tab_bar_padding", "tab_gap", "tab_color", "tab_background", "tab_font_size", "tab_font_weight", "tab_font_family", "tab_text_transform", "tab_border_color", "tab_border_width", "tab_radius", "tab_padding", "tab_active_color", "tab_active_background", "tab_indicator_color", "tab_icon_position", "tab_icon_size", "tab_animation", "css"],
    "structure": ["hover", "conditional"],
    "conditional_rule": ["id", "name", "conditions", "mode", "design"]
  },
  "display": {
    "keys": ["conditions", "mode"],
    "condition_keys": ["id", "type", "entity", "use_module_entity", "attribute", "state", "state_not", "above", "below", "after", "before", "template", "condition"],
    "condition_types": ["state", "attribute", "time", "template"]
  },
  "actions": {
    "slots": ["tap_action", "hold_action", "double_tap_action"],
    "plain_types": ["none", "more-info", "toggle", "navigate", "url", "perform-action", "assist", "fire-dom-event", "call-service"],
    "note": "Other keys on an action object are an opaque payload (fire-dom-event takes arbitrary keys); only `action` decides."
  },
  "background_layers": {
    "plain_types": ["color", "gradient", "image", "pattern"],
    "plain_keys": ["type", "hidden", "opacity", "blend", "image", "entity", "attribute", "states", "position", "size", "repeat", "blur", "gradient", "color", "pattern", "thickness"],
    "feature_keys": {
      "pan_zoom": "motion",
      "refresh": "snapshot refresh timer",
